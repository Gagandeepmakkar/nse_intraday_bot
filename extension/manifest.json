{
  "manifest_version": 3,
  "name": "NSE Groww Live",
  "version": "1.1.0",
  "description": "Live trade assistant on your Groww chart: multi-timeframe scored BUY/SELL (parity with nse_live.pine), structural stop, trade management, mini chart, desktop alerts. Uses your own Groww session data. Manual execution only.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "NSE Groww Live"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://groww.in/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://groww.in/*"],
      "js": ["inject_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://groww.in/*"],
      "js": ["lib/lwc.js", "algos.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
