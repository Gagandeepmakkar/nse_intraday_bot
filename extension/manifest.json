{
  "manifest_version": 3,
  "name": "NSE Intraday Live Confirm",
  "version": "0.4.0",
  "description": "Runs multiple algorithms live on the bot's picks (popup) and overlays BUY/SELL/target on your Groww chart. Manual execution only.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "NSE Intraday Live Confirm"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://groww.in/*"],
      "js": ["lib/lwc.js", "algos.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
