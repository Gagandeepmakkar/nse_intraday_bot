                    _inserted = false
                    if _todayEndTimes.size() > 0
                        for _j = 0 to _todayEndTimes.size() - 1
                            if _s.sessEndTime < _todayEndTimes.get(_j)
                                _todayEndTimes.insert(_j, _s.sessEndTime)
                                _todayIndices.insert(_j, _si)
                                _inserted := true
                                break
                    if not _inserted
                        _todayEndTimes.push(_s.sessEndTime)
                        _todayIndices.push(_si)

    _toExtend = array.new<int>()
    if _todayIndices.size() > 0
        _total  = _todayIndices.size()
        _nLimit = math.min(extendLastN, _total)
        for _k = 0 to _nLimit - 1
            _toExtend.push(_todayIndices.get(_total - 1 - _k))

