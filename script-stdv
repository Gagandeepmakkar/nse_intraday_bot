cisd_bearStr       = input.string('-CISD', ' ',                      tooltip = 'Text displayed next to the -CISD level.', inline = 'cisd_bep', group = 'CISD')
cisd_bearAlerts    = input.bool(false,   'Alert?',                   tooltip = 'Send alert when price closes ABOVE the current -CISD level.', inline = 'cisd_bep', group = 'CISD')
cisd_lineWidth     = input.int(1,        'Line Width',               minval = 1, maxval = 5, group = 'CISD')
cisd_lookAheadBars = input.int(5,        'Line Extension Bars',      minval = 1, maxval = 5, group = 'CISD')
cisd_styleOption   = input.string('Solid (─)', 'Line Style',         options = ['Solid (─)', 'Dotted (┈)', 'Dashed (╌)'], group = 'CISD')
cisd_keepLevels    = input.bool(true,    'Keep old CISD levels',     group = 'CISD')
cisd_showTable     = input.bool(false,   'Enable stat table',        group = 'CISD')
cisd_tablePosition = input.string('Top Right', 'Table Position',     options = ['Top Right', 'Bottom Right', 'Middle Right', 'Bottom Center', 'Middle Left'], group = 'CISD')

cisd_filterFirstHour    = input.bool(true, 'Only Oro hour CISD',
     tooltip = 'When ON, CISD levels are only drawn if the pullback started inside the first hour of any enabled session.',
     group = 'CISD')
cisd_filterSessionBreak = input.bool(false, 'Only After Session H/L Sweep',
     tooltip = 'When ON, CISD levels are only drawn after price has swept (broken) the previous session High or Low.',
     group = 'CISD')

type CisdMarketStructure
    float topPrice
    float bottomPrice
    bool  isBullish

type CisdLevel
    line  level
    label txt
    bool  completed

cisd_lineStyle = cisd_styleOption == 'Dotted (┈)' ? line.style_dotted :
                 cisd_styleOption == 'Dashed (╌)' ? line.style_dashed :
                 line.style_solid

var CisdMarketStructure cisd_currentStructure = CisdMarketStructure.new(0, 0, false)
var cisdLevelsBu = array.new<CisdLevel>()
var cisdLevelsBe = array.new<CisdLevel>()

var bool  cisd_isBullishPullback    = false
var bool  cisd_isBearishPullback    = false
var float cisd_potentialTopPrice    = na
var float cisd_potentialBottomPrice = na
var int   cisd_bullishBreakIndex    = na
var int   cisd_bearishBreakIndex    = na
var bool  cisd_currentState         = false

var float cisd_prevSessHigh  = na
var float cisd_prevSessLow   = na
var bool  cisd_sessHighSwept = false
var bool  cisd_sessLowSwept  = false
var float cisd_runningH      = na
var float cisd_runningL      = na
var bool  cisd_inAnySess     = false

cisd_inFirstHourAny = false
sessArr7  = array.from(a1, a2, a3, a4, a5, a6, a7)
showArr7  = array.from(sydShow, tokShow, lonShow, nycShow, fraShow, hkgShow, bomShow)
timesArr7 = array.from(sydTime, tokTime, lonTime, nycTime, fraTime, hkgTime, bomTime)

for _i = 0 to 6
    if array.get(showArr7, _i)
        _s = array.get(sessArr7, _i)
        _t = array.get(timesArr7, _i)
        _inSess = not na(time(timeframe.period, _t, utc))
        if _inSess
            if not na(_s.st) and (time - _s.st) < ONE_HOUR_MS
                cisd_inFirstHourAny := true
            if not cisd_inAnySess
                if not na(cisd_runningH) and not na(cisd_runningL)
                    cisd_prevSessHigh  := cisd_runningH
                    cisd_prevSessLow   := cisd_runningL
                    cisd_sessHighSwept := false
                    cisd_sessLowSwept  := false
                cisd_runningH := high
                cisd_runningL := low
            else
                cisd_runningH := math.max(nz(cisd_runningH, high), high)
                cisd_runningL := math.min(nz(cisd_runningL, low),  low)
            cisd_inAnySess := true

if not cisd_inAnySess
    cisd_inAnySess := false

if not na(cisd_prevSessHigh) and high > cisd_prevSessHigh
    cisd_sessHighSwept := true
if not na(cisd_prevSessLow) and low < cisd_prevSessLow
    cisd_sessLowSwept  := true

cisd_filtersPass(int dir) =>
    bool f1      = cisd_filterFirstHour    ? cisd_inFirstHourAny : true
    bool sweepOk = dir == 1 ? cisd_sessLowSwept : cisd_sessHighSwept
    bool f2      = cisd_filterSessionBreak ? sweepOk : true
    f1 and f2

cisd_getTablePos(pos) =>
    switch pos
        'Top Right'     => position.top_right
        'Bottom Right'  => position.bottom_right
        'Middle Right'  => position.middle_right
        'Bottom Center' => position.bottom_center
        'Middle Left'   => position.bottom_left

if cisd_enable
    bool cisd_bearishPullbackDetected = close[1] > open[1]
    bool cisd_bullishPullbackDetected = close[1] < open[1]

    if cisd_bearishPullbackDetected and not cisd_isBearishPullback
        cisd_isBearishPullback := true
        cisd_potentialTopPrice := open[1]
        cisd_bullishBreakIndex := bar_index[1]

    if cisd_bullishPullbackDetected and not cisd_isBullishPullback
        cisd_isBullishPullback    := true
        cisd_potentialBottomPrice := open[1]
        cisd_bearishBreakIndex    := bar_index[1]

    if cisd_isBullishPullback
        if open < cisd_potentialBottomPrice
            cisd_potentialBottomPrice := open
            cisd_bearishBreakIndex    := bar_index
        if (close < open) and (open > cisd_potentialBottomPrice)
            cisd_potentialBottomPrice := open
            cisd_bearishBreakIndex    := bar_index

    if cisd_isBearishPullback
        if open > cisd_potentialTopPrice
            cisd_potentialTopPrice := open
            cisd_bullishBreakIndex := bar_index
        if (close > open) and open < cisd_potentialTopPrice
            cisd_potentialTopPrice := open
            cisd_bullishBreakIndex := bar_index

    if low < cisd_currentStructure.bottomPrice
        cisd_currentStructure.bottomPrice := low
        cisd_currentStructure.isBullish   := false

        if cisd_isBearishPullback and (bar_index - cisd_bullishBreakIndex != 0)
            cisd_currentStructure.topPrice := math.max(high[bar_index - cisd_bullishBreakIndex], high[bar_index - cisd_bullishBreakIndex + 1])
            cisd_isBearishPullback := false
            if cisd_filtersPass(1)
                cisd_bLine = line.new(cisd_bullishBreakIndex, cisd_potentialTopPrice, bar_index + cisd_lookAheadBars, cisd_potentialTopPrice, color = cisd_bullColor, width = cisd_lineWidth, style = cisd_lineStyle)
                cisd_bLbl  = label.new(bar_index + cisd_lookAheadBars, cisd_potentialTopPrice, cisd_bullStr, color = color.new(color.white, 100), textcolor = cisd_bullColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
                cisdLevelsBe.push(CisdLevel.new(cisd_bLine, cisd_bLbl, false))

        else if close[1] > open[1] and close < open
            cisd_currentStructure.topPrice := high[1]
            cisd_isBearishPullback := false
            if cisd_filtersPass(1)
                cisd_bLine = line.new(cisd_bullishBreakIndex, cisd_potentialTopPrice, bar_index + cisd_lookAheadBars, cisd_potentialTopPrice, color = cisd_bullColor, width = cisd_lineWidth, style = cisd_lineStyle)
                cisd_bLbl  = label.new(bar_index + cisd_lookAheadBars, cisd_potentialTopPrice, cisd_bullStr, color = color.new(color.white, 100), textcolor = cisd_bullColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
                cisdLevelsBe.push(CisdLevel.new(cisd_bLine, cisd_bLbl, false))

    if high > cisd_currentStructure.topPrice
        cisd_currentStructure.isBullish := true
        cisd_currentStructure.topPrice  := high

        if cisd_isBullishPullback and (bar_index - cisd_bearishBreakIndex != 0)
            cisd_currentStructure.bottomPrice := math.min(low[bar_index - cisd_bearishBreakIndex], low[bar_index - cisd_bearishBreakIndex + 1])
            cisd_isBullishPullback := false
            if cisd_filtersPass(-1)
                cisd_buLine = line.new(cisd_bearishBreakIndex, cisd_potentialBottomPrice, bar_index + cisd_lookAheadBars, cisd_potentialBottomPrice, color = cisd_bearColor, width = cisd_lineWidth, style = cisd_lineStyle)
                cisd_buLbl  = label.new(bar_index + cisd_lookAheadBars, cisd_potentialBottomPrice, cisd_bearStr, color = color.new(color.white, 100), textcolor = cisd_bearColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
                cisdLevelsBu.push(CisdLevel.new(cisd_buLine, cisd_buLbl, false))

        else if close[1] < open[1] and close > open
            cisd_currentStructure.bottomPrice := low[1]
            cisd_isBullishPullback := false
            if cisd_filtersPass(-1)
                cisd_buLine = line.new(cisd_bearishBreakIndex, cisd_potentialBottomPrice, bar_index + cisd_lookAheadBars, cisd_potentialBottomPrice, color = cisd_bearColor, width = cisd_lineWidth, style = cisd_lineStyle)
                cisd_buLbl  = label.new(bar_index + cisd_lookAheadBars, cisd_potentialBottomPrice, cisd_bearStr, color = color.new(color.white, 100), textcolor = cisd_bearColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
                cisdLevelsBu.push(CisdLevel.new(cisd_buLine, cisd_buLbl, false))

    if array.size(cisdLevelsBu) > 1 and not cisd_keepLevels
        cisd_old = array.shift(cisdLevelsBu)
        line.delete(cisd_old.level)
        label.delete(cisd_old.txt)

    if array.size(cisdLevelsBe) > 1 and not cisd_keepLevels
        cisd_old = array.shift(cisdLevelsBe)
        line.delete(cisd_old.level)
        label.delete(cisd_old.txt)

    if array.size(cisdLevelsBu) >= 1
        cisd_latestBu = array.get(cisdLevelsBu, 0)
        if not cisd_latestBu.completed
            if not (close < cisd_latestBu.level.get_y2())
                line.set_x2(cisd_latestBu.level, bar_index + cisd_lookAheadBars)
                label.set_x(cisd_latestBu.txt,   bar_index + cisd_lookAheadBars)
            else
                cisd_latestBu.completed := true
                if cisd_bearAlerts
                    alert('Bearish CISD Formed')
                if cisd_filtersPass(1)
                    cisd_bLine2 = line.new(cisd_bullishBreakIndex, cisd_potentialTopPrice, bar_index + cisd_lookAheadBars, cisd_potentialTopPrice, color = cisd_bullColor, width = cisd_lineWidth, style = cisd_lineStyle)
                    cisd_bLbl2  = label.new(bar_index + cisd_lookAheadBars, cisd_potentialTopPrice, cisd_bullStr, color = color.new(color.white, 100), textcolor = cisd_bullColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
                    cisdLevelsBe.push(CisdLevel.new(cisd_bLine2, cisd_bLbl2, false))
                cisd_currentState := false

    if array.size(cisdLevelsBe) >= 1 and not cisd_keepLevels
        cisd_latestBe = array.get(cisdLevelsBe, 0)
        if not cisd_latestBe.completed
            if not (close > cisd_latestBe.level.get_y2())
                line.set_x2(cisd_latestBe.level, bar_index + cisd_lookAheadBars)
                label.set_x(cisd_latestBe.txt,   bar_index + cisd_lookAheadBars)
            else
                cisd_latestBe.completed := true
                if cisd_bullAlerts
                    alert('Bullish CISD Formed')
                if cisd_filtersPass(-1)
                    cisd_buLine2 = line.new(cisd_bearishBreakIndex, cisd_potentialBottomPrice, bar_index + cisd_lookAheadBars, cisd_potentialBottomPrice, color = cisd_bearColor, width = cisd_lineWidth, style = cisd_lineStyle)
                    cisd_buLbl2  = label.new(bar_index + cisd_lookAheadBars, cisd_potentialBottomPrice, cisd_bearStr, color = color.new(color.white, 100), textcolor = cisd_bearColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
                    cisdLevelsBu.push(CisdLevel.new(cisd_buLine2, cisd_buLbl2, false))
                cisd_currentState := true

if cisd_enable and cisd_showTable and barstate.islast
    var cisd_tbl = table.new(cisd_getTablePos(cisd_tablePosition), 2, 3,
         bgcolor      = chart.bg_color,
         border_color = chart.fg_color,
         frame_color  = chart.fg_color,
         frame_width  = 1,
         border_width = 1)
    table.cell(cisd_tbl, 0, 0, syminfo.ticker + ', ' + timeframe.period + ' CISD',
         text_size        = size.tiny,
         text_color       = chart.fg_color,
         text_font_family = font.family_monospace)
    table.cell(cisd_tbl, 0, 1, 'Current State',
         text_color       = chart.bg_color,
         text_size        = size.small,
         text_font_family = font.family_monospace,
         text_formatting  = text.format_bold,
         bgcolor          = chart.fg_color)
    table.cell(cisd_tbl, 0, 2, cisd_currentState ? 'Bullish' : 'Bearish',
         text_color       = chart.fg_color,
         text_size        = size.small,
         text_font_family = font.family_monospace,
         text_formatting  = text.format_bold)

alertcondition(cisd_enable and cisd_bullAlerts and cisd_currentState,     'Bullish CISD', 'Bullish CISD formed')
alertcondition(cisd_enable and cisd_bearAlerts and not cisd_currentState, 'Bearish CISD', 'Bearish CISD formed')
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ EXTRA CLEANUP on last bar — expired lines/boxes jo session-start pe miss ho gayi {
if barstate.islast
    int _lineCutoff2 = timenow - HISTORY_MS
    int _boxCutoff2  = timenow - BOX_HISTORY_MS
    _cleanSess = array.from(a1, a2, a3, a4, a5, a6, a7)
    for _ci = 0 to 6
        _cs = array.get(_cleanSess, _ci)

        while _cs.closingLineTimes.size() > 0 and _cs.closingLineTimes.get(0) < _lineCutoff2
            line.delete(_cs.closingLines.shift())
            _cs.closingLineTimes.shift()
            if _cs.closingLabels.size() > 0
                label.delete(_cs.closingLabels.shift())

        while _cs.histBoTimes.size() > 0 and _cs.histBoTimes.get(0) < _boxCutoff2
            box.delete(_cs.histBo.shift())
            box.delete(_cs.histFbo.shift())
            _cs.histBoTimes.shift()

        while _cs.histLabelTimes.size() > 0 and _cs.histLabelTimes.get(0) < _boxCutoff2
            label.delete(_cs.histSessLabels.shift())
            _cs.histLabelTimes.shift()
            if _cs.histExecLabels.size() > 0
                label.delete(_cs.histExecLabels.shift())
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ ACTIVE flo/bo CLEANUP {
if barstate.islast
    int _lineCutoff3 = timenow - HISTORY_MS
    int _boxCutoff3  = timenow - BOX_HISTORY_MS
    _activeSess = array.from(a1, a2, a3, a4, a5, a6, a7)
    for _ai = 0 to 6
        _as = array.get(_activeSess, _ai)

        if _as.flo.size() > 0
            bool _floExpired = false
            if not na(_as.sessEndTime) and _as.sessEndTime < _lineCutoff3
                _floExpired := true
            else if not na(_as.st) and _as.st < _lineCutoff3 and na(_as.sessEndTime)
                _floExpired := true
            if _floExpired
                line.delete(_as.flo.get(0))
                _as.flo.clear()
                if _as.endLabel.size() > 0
                    label.delete(_as.endLabel.get(0))
                    _as.endLabel.clear()

        if _as.bo.size() > 0
            bool _boExpired = false
            if not na(_as.sessEndTime) and _as.sessEndTime < _boxCutoff3
                _boExpired := true
            else if not na(_as.st) and _as.st < _boxCutoff3 and na(_as.sessEndTime)
                _boExpired := true
            if _boExpired
                box.delete(_as.bo.get(0))
                _as.bo.clear()
                if _as.fbo.size() > 0
                    box.delete(_as.fbo.get(0))
                    _as.fbo.clear()
                if _as.sessLabel.size() > 0
                    label.delete(_as.sessLabel.get(0))
                    _as.sessLabel.clear()
                if _as.flabel.size() > 0
                    label.delete(_as.flabel.get(0))
                    _as.flabel.clear()
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~