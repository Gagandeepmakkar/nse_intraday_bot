    int _utc4Now    = timenow + (-4 * 60 * 60 * 1000)
    int _utc4DayMs  = 24 * 60 * 60 * 1000
    int _utc4MidnightMs = _utc4Now - (_utc4Now % _utc4DayMs)
    int _todayStartUtc = _utc4MidnightMs + (4 * 60 * 60 * 1000)
    int _todayEndUtc   = _todayStartUtc + _utc4DayMs

    _todayEndTimes = array.new<int>()
    _todayIndices  = array.new<int>()

    for _si = 0 to 6
        if array.get(show, _si)
            _s = array.get(_allSess, _si)
