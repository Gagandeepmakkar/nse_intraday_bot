                if _isToday and _toExtend.includes(_si)
                    line.set_x2(_s.flo.get(0), _s.sessEndBar + _extBars)
                    if array.size(_s.endLabel) > 0
                        label.set_x(_s.endLabel.get(0), _s.sessEndBar + _extBars)
                else
                    if not na(_s.sessEndBar)
                        line.set_x2(_s.flo.get(0), _s.sessEndBar)
                        if array.size(_s.endLabel) > 0
                            label.set_x(_s.endLabel.get(0), _s.sessEndBar)
                    else
                        line.set_x2(_s.flo.get(0), bar_index)
                        if array.size(_s.endLabel) > 0
                            label.set_x(_s.endLabel.get(0), bar_index)
