fib_lblText(ratio, price) =>
    _lvlStr = fib_showLvl
         ? (fib_lvlStyle == 'Percent'
              ? str.tostring(math.round(ratio * 100)) + '%'
              : str.tostring(ratio))
         : ''
    _priceStr = fib_showPrices ? str.tostring(math.round_to_mintick(price)) : ''
    _sep = fib_showLvl and fib_showPrices ? '  ' : ''
    _lvlStr + _sep + _priceStr

fib_countVisibleLevels() =>
    int _cnt = 0
    for _li = 0 to g_fibShows.size() - 1
        if g_fibShows.get(_li)
            _cnt += 1
    _cnt

fib_drawAll(int sessIdx, float fhH, float fhL, int x1, int extBars, string sessNm) =>
    if fib_masterEnable
        _base  = fib_reverse ? fhL : fhH
        _range = fhH - fhL
        _lArr  = fib_getLineArr(sessIdx)
        _lblArr= fib_getLabelArr(sessIdx)
        _x2    = x1 + extBars
        _lstyle= fib_toLineStyle(fib_lineStyle)
        _ext   = fib_toExtend(fib_extendDir)
        _lsize = fib_toSize(fib_fontSize)
        _bgArr = fib_getBgArr(sessIdx)

        _levels = g_fibVals
        _shows  = g_fibShows
        _colors = g_fibCols

        _visibleLvlCount = fib_countVisibleLevels()
        _lblMultiplier   = fib_lblPos == 'Both' ? 2 : 1
        _linesPerSet     = _visibleLvlCount
        _labelsPerSet    = _visibleLvlCount * _lblMultiplier
        _bgPerSet        = math.max(0, _visibleLvlCount - 1)

        // ── ✅ CHANGE 2: fib_maxSessions == 0 → treat as 1 slot (always replace) ──
        int _effectiveMax = fib_maxSessions == 0 ? 1 : fib_maxSessions
        int _curCount = fib_drawCount.get(sessIdx)
        if _curCount >= _effectiveMax
            int _linesToDel = math.min(_linesPerSet, _lArr.size())
            for _d = 0 to _linesToDel - 1
                if _lArr.size() > 0
                    line.delete(_lArr.shift())
            int _lblsToDel = math.min(_labelsPerSet, _lblArr.size())
            for _d = 0 to _lblsToDel - 1
                if _lblArr.size() > 0
                    label.delete(_lblArr.shift())
            int _bgToDel = math.min(_bgPerSet, _bgArr.size())
            for _d = 0 to _bgToDel - 1
                if _bgArr.size() > 0
                    box.delete(_bgArr.shift())
        else
            fib_drawCount.set(sessIdx, _curCount + 1)

        var float _prevPrice = na
        _prevPrice := na

        for _li = 0 to _levels.size() - 1
            if _shows.get(_li)
                _ratio = _levels.get(_li)
                _price = fib_reverse
                     ? _base + _ratio * _range
                     : _base - _ratio * _range
                _clr   = _colors.get(_li)

                if fib_showBg and not na(_prevPrice)
                    _bgClr = color.new(_clr, fib_bgTransp)
                    _bgBox = box.new(x1, math.max(_price, _prevPrice),
                             _x2, math.min(_price, _prevPrice),
                             border_color = color.new(color.black, 100),
                             bgcolor      = _bgClr,
                             extend       = extend.none)
                    fib_getBgArr(sessIdx).push(_bgBox)

                _prevPrice := _price

                _ln = line.new(x1, _price, _x2, _price,
                     xloc   = xloc.bar_index,
                     color  = _clr,
                     width  = fib_lineWidth,
                     style  = _lstyle,
                     extend = _ext)
                _lArr.push(_ln)

                _txt = fib_lblText(_ratio, _price)
                if fib_showLvl or fib_showPrices
                    if fib_lblPos == 'Left' or fib_lblPos == 'Both'
                        _lstyleL = fib_lblStyle('Left', fib_lblAlign)
                        _lb = label.new(x1, _price, _txt,
                             xloc      = xloc.bar_index,
                             style     = _lstyleL,
                             color     = color.new(color.black, 100),
                             textcolor = _clr,
                             size      = _lsize,
                             textalign = fib_txtAlign == 'Left' ? text.align_left :
                                          fib_txtAlign == 'Right' ? text.align_right :
                                          text.align_center)
                        _lblArr.push(_lb)
                    if fib_lblPos == 'Right' or fib_lblPos == 'Both'
                        _lstyleR = fib_lblStyle('Right', fib_lblAlign)
                        _lb2 = label.new(_x2, _price, _txt,
                             xloc      = xloc.bar_index,
                             style     = _lstyleR,
                             color     = color.new(color.black, 100),
                             textcolor = _clr,
                             size      = _lsize,
                             textalign = fib_txtAlign == 'Left' ? text.align_left :
                                          fib_txtAlign == 'Right' ? text.align_right :
                                          text.align_center)
                        _lblArr.push(_lb2)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ session logic {
method RunSessions(Sessions x, int i, bool session) =>
    if show.get(i)

        if session and not session[1]
            x.leftBar    := bar_index
            x.st         := time
            x.o          := open
            x.h          := high
            x.l          := low
            x.c          := close
            x.sessEndBar := na

            fvg_firstDoneBull.set(i, false)
            fvg_firstDoneBear.set(i, false)
            fvg_lastDoneBull.set(i, false)
            fvg_lastDoneBear.set(i, false)
            fvg_sessEndTimeArr.set(i, na)
            x.tcFvgDoneBull := false
            x.tcFvgDoneBear := false
            x.fibDrawn      := false
            x.fhHigh        := 0.0

            if array.size(x.flo) > 0
                if not na(x.sessEndBar)
                    line.set_x2(x.flo.get(0), x.sessEndBar)
                    if array.size(x.endLabel) > 0
                        label.set_x(x.endLabel.get(0), x.sessEndBar)
                else
                    line.set_x2(x.flo.get(0), bar_index - 1)
                    if array.size(x.endLabel) > 0
                        label.set_x(x.endLabel.get(0), bar_index - 1)
                x.closingLines.push(x.flo.get(0))
                x.closingLineTimes.push(nz(x.sessEndTime, time))
                if array.size(x.endLabel) > 0
                    x.closingLabels.push(x.endLabel.get(0))
                    x.endLabel.clear()
                x.flo.clear()

            if array.size(x.bo) > 0
                x.histBo.push(x.bo.get(0))
                x.histFbo.push(x.fbo.get(0))
                x.histBoTimes.push(nz(x.sessEndTime, time))
                x.bo.clear()
                x.fbo.clear()

            if array.size(x.sessLabel) > 0
                x.histSessLabels.push(x.sessLabel.get(0))
                x.histLabelTimes.push(nz(x.sessEndTime, time))
                x.sessLabel.clear()
            if array.size(x.flabel) > 0
                x.histExecLabels.push(x.flabel.get(0))
                x.flabel.clear()

            int _lineCutoff = timenow - HISTORY_MS
            int _boxCutoff  = timenow - BOX_HISTORY_MS

            while x.closingLineTimes.size() > 0 and x.closingLineTimes.get(0) < _lineCutoff
                line.delete(x.closingLines.shift())
                x.closingLineTimes.shift()
                if x.closingLabels.size() > 0
                    label.delete(x.closingLabels.shift())

            while x.histBoTimes.size() > 0 and x.histBoTimes.get(0) < _boxCutoff
                box.delete(x.histBo.shift())
                box.delete(x.histFbo.shift())
                x.histBoTimes.shift()

            while x.histLabelTimes.size() > 0 and x.histLabelTimes.get(0) < _boxCutoff
                label.delete(x.histSessLabels.shift())
                x.histLabelTimes.shift()
                if x.histExecLabels.size() > 0
                    label.delete(x.histExecLabels.shift())

            fullBox = box.new(bar_index, high, bar_index, low,
             border_color = showSessionBrdr ? colors.get(i) : color.new(color.black, 100),
             border_style = line.style_dashed,
             bgcolor      = showSessionBg ? color.new(colors.get(i), 80) : color.new(color.black, 100),
             border_width = sessionBorderWidth,
             extend       = extend.none)
            x.bo.unshift(fullBox)

            hourBox = box.new(bar_index, high, bar_index, low,
             border_color = showFirstHourBrd ? color.new(firstHourColors.get(i), 0) : color.new(color.black, 100),
             bgcolor      = showFirstHourBg  ? color.new(firstHourColors.get(i), 80) : color.new(color.black, 100),
             border_width = firstHourBorderWidth,
             extend       = extend.none)
            x.fbo.unshift(hourBox)

            midXx = x.leftBar

            sessLbl = label.new(midXx, x.h,
                         text      = array.get(sessionNames, i),
                         style     = label.style_label_lower_right,
                         textcolor = showExHour ? chart.fg_color : na,
                         color     = na,
                         size      = toSize(execHourLabelSize),
                         textalign = text.align_center,
                         tooltip   = "Session name")
            x.sessLabel.unshift(sessLbl)

            execLbl = label.new(midXx, x.l,
                         text      = 'Oro_☠ Hour',
                         style     = label.style_label_upper_left,
                         textcolor = showExHour ? chart.fg_color : na,
                         color     = na,
                         size      = toSize(execHourLabelSize),
                         textalign = text.align_left,
                         tooltip   = "Institutional view: True Close ≠ Official Close.\nMost funds treat the first hour of the next day as the real close — where final flows, rebalancing, and execution dust settles.")
            x.flabel.unshift(execLbl)

        if session
            x.h := math.max(high, x.h)
            x.l := math.min(low,  x.l)
            x.c := close

            fb = x.bo.get(0)
            box.set_rightbottom(fb, bar_index, x.l)
            box.set_top(fb, x.h)

            if not na(x.st) and time - x.st < ONE_HOUR_MS
                fh = x.fbo.get(0)
                box.set_rightbottom(fh, bar_index, x.l)
                box.set_top(fh, x.h)

            if array.size(x.sessLabel) > 0
                midBar = x.leftBar + math.round((bar_index - x.leftBar) / 2)
                label.set_x(x.sessLabel.get(0), midBar)
                label.set_y(x.sessLabel.get(0), x.h)

            if not na(x.st) and time - x.st < ONE_HOUR_MS
                x.fhLow  := x.l
                x.fhHigh := x.h

            if array.size(x.flabel) > 0
                label.set_y(x.flabel.get(0), x.l)

            if not na(x.st) and time - x.st >= ONE_HOUR_MS and array.size(x.flo) == 0 and showLine
                x.lineDrawBar  := bar_index
                x.lineStartBar := bar_index - 1
                x.linePrice    := close[1]
                l = line.new(
                 x1     = x.lineStartBar, y1 = x.linePrice,
                 x2     = bar_index,      y2 = x.linePrice,
                 xloc   = xloc.bar_index,
                 extend = extend.none,
                 color  = lineColors.get(i),
                 width  = lineWidth,
                 style  = line.style_solid)
                x.flo.unshift(l)

                if array.size(x.endLabel) > 0
                    label.delete(x.endLabel.get(0))
                    x.endLabel.clear()

                txt = str.format("{0} – {1}", array.get(sessionNames, i), str.tostring(x.linePrice))
                lb = label.new(
                 x         = bar_index,
                 y         = x.linePrice,
                 text      = txt,
                 xloc      = xloc.bar_index,
                 style     = label.style_label_left,
                 color     = color.new(color.black, 100),
                 textcolor = showTrueClose ? chart.fg_color : na,
                 size      = toSize(trueCloseLabelSize),
                 tooltip   = "Institutions often treat this level — the close of the first hour — as the true close of the prior day.")
                x.endLabel.unshift(lb)

            if fib_masterEnable and fib_enable and fib_sessEnables.get(i) and not na(x.st) and time - x.st >= ONE_HOUR_MS and not x.fibDrawn
                if x.fhHigh > x.fhLow
                    x.fibDrawn := true
                    _fibX1 = x.leftBar
                    fib_drawAll(i, x.fhHigh, x.fhLow, _fibX1, fib_extend,
                                array.get(sessionNames, i))

            if array.size(x.flo) > 0
                line.set_xy2(x.flo.get(0), bar_index, x.linePrice)
                if array.size(x.endLabel) > 0
                    label.set_x(x.endLabel.get(0), bar_index)
                    label.set_y(x.endLabel.get(0), x.linePrice)

            if tcFvg_enable and not na(x.linePrice) and not na(x.st)
                _tcNm      = array.get(sessionNames, i)
                _tcLine    = x.linePrice
                _tcBullFVG = low[0] > high[2]
                _tcBearFVG = high[0] < low[2]
                _tcBullAbove = _tcBullFVG and high[2] >= _tcLine
                _tcBearBelow = _tcBearFVG and low[2] <= _tcLine
                if _tcBullAbove and not x.tcFvgDoneBull
                    x.tcFvgDoneBull := true
                    tcfvg_draw(i, true, low[0], high[2], _tcNm)
                if _tcBearBelow and not x.tcFvgDoneBear
                    x.tcFvgDoneBear := true
                    tcfvg_draw(i, false, low[2], high[0], _tcNm)

            if fvg_enable and not na(x.st)
                _nm = array.get(sessionNames, i)
                _isAfterFH = time - x.st >= ONE_HOUR_MS
                _sessStr       = times.get(i)
                _startHH       = str.tonumber(str.substring(_sessStr, 0, 2))
                _startMM       = str.tonumber(str.substring(_sessStr, 2, 4))
                _endHH         = str.tonumber(str.substring(_sessStr, 5, 7))
                _endMM         = str.tonumber(str.substring(_sessStr, 7, 9))
                _startTotalMin = _startHH * 60 + _startMM
                _endTotalMin   = _endHH   * 60 + _endMM
                _sessDurMin    = _endTotalMin > _startTotalMin
                     ? _endTotalMin - _startTotalMin
                     : (1440 - _startTotalMin) + _endTotalMin
                _sessDurBars   = math.round(_sessDurMin    / timeframe.multiplier)
                _elapsedBars   = bar_index - x.leftBar
                _remainBars    = _sessDurBars - _elapsedBars
                _lastWinBars   = math.round(fvg_lastWinMin / timeframe.multiplier)
                _isInLastWin   = _remainBars <= _lastWinBars and _remainBars >= 0
                _isBullFVG = low[0] > high[2]
                _isBearFVG = high[0] < low[2]
                _bullTop = low[0]
                _bullBot = high[2]
                _bearTop = low[2]
                _bearBot = high[0]

                _isInFirstHour = time - x.st < ONE_HOUR_MS

                if fvg_showFirst and _isInFirstHour
                    if _isBullFVG and not fvg_firstDoneBull.get(i)
                        fvg_firstDoneBull.set(i, true)
                        fvg_draw(i, true,  _bullTop, _bullBot, 'F', _nm, true)
                    if _isBearFVG and not fvg_firstDoneBear.get(i)
                        fvg_firstDoneBear.set(i, true)
                        fvg_draw(i, false, _bearTop, _bearBot, 'F', _nm, true)

                if fvg_showLast and _isInLastWin
                    if _isBullFVG
                        fvg_draw(i, true,  _bullTop, _bullBot, 'L', _nm, false)
                        fvg_lastDoneBull.set(i, true)
                    if _isBearFVG
                        fvg_draw(i, false, _bearTop, _bearBot, 'L', _nm, false)
                        fvg_lastDoneBear.set(i, true)

        if not session and session[1]
            x.sessEndBar  := bar_index - 1
            x.sessEndTime := time
            if array.size(x.flo) > 0
                line.set_x2(x.flo.get(0), x.sessEndBar)
                if array.size(x.endLabel) > 0
                    label.set_x(x.endLabel.get(0), x.sessEndBar)

            // ── ✅ CHANGE 3: fib_maxSessions == 0 → session khatam hote hi fib delete ──
            if fib_maxSessions == 0 and fib_masterEnable and fib_enable
                _fLArr   = fib_getLineArr(i)
                _fLblArr = fib_getLabelArr(i)
                _fBgArr  = fib_getBgArr(i)
                while _fLArr.size() > 0
                    line.delete(_fLArr.shift())
                while _fLblArr.size() > 0
                    label.delete(_fLblArr.shift())
                while _fBgArr.size() > 0
                    box.delete(_fBgArr.shift())
                fib_drawCount.set(i, 0)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

