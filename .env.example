# Copy to .env and fill locally. Never commit or share .env.

# Data source: yahoo | nse | kite | dhan | mock (override at runtime with --source or --offline).
# yahoo = free, token-free (yfinance); no depth/order-flow and ~15-min delayed quotes.
# nse   = free hybrid: Yahoo snapshot/candles + NSE live index levels, real market/
#         holiday state, and real PRE-OPEN gaps + order imbalance (09:00-09:15).
#         Mid-session equity quotes still fall back to Yahoo (NSE blocks free live
#         per-stock quotes). Best when run in the pre-open window.
SOURCE=yahoo

# Zerodha Kite Connect (paid historical add-on required).
KITE_API_KEY=
KITE_API_SECRET=

# DhanHQ (free historical data; live quote/depth may need Dhan's Data API plan).
# Generate the access token in the Dhan web dashboard -> DhanHQ API section.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional AI news-summary layer. Scanner still runs without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Telegram: create a bot with @BotFather; get chat_id from your private chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP. For Gmail, use an app password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Capital and guardrails (evidence-backed defaults; re-validate with backtest.py)
TRADING_CAPITAL_INR=100000
RISK_PER_TRADE_PCT=0.5
MAX_CANDIDATES=2
MIN_AVG_DAILY_TURNOVER_INR=50000000
MIN_RELATIVE_VOLUME=1.5
MIN_NET_REWARD_RISK=1.3
MIN_DAILY_RANGE_PCT=1.2
CANDLE_INTERVAL=5minute
LOOKBACK_DAYS=10
STALE_CANDLE_MINUTES=30
MARKET_TIMEZONE=Asia/Kolkata

# Scheduler (scheduler.py / ./run.sh auto) — IST times to run the scan on weekdays.
# Keep a slot before 09:15 (e.g. 09:12 or 08:45) so the pre-market briefing fires.
RUN_TIMES_IST=09:12,10:15,13:15

# Pre-market briefing (briefing.py). Comma-separated NSE symbols to brief each morning.
# Leave blank to disable the auto-briefing. Phone push uses NTFY_TOPIC below.
BRIEF_SYMBOLS=RELIANCE
# ntfy.sh topic for free phone push (same topic you subscribed to in the ntfy app).
NTFY_TOPIC=
# Optional: Google AI Studio (Gemini) API key — when set, the briefing uses AI to read
# the day's headlines (smarter sentiment + a risk-caution line). Falls back to a keyword
# tilt if blank. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Risk gate (risk.py) — deterministic pre-trade checks + daily-loss kill-switch.
# Defaults derive from capital/RISK_PER_TRADE_PCT if left blank.
RISK_MAX_LOSS_PER_TRADE_INR=
RISK_MAX_DAILY_LOSS_INR=
RISK_MAX_TRADES_PER_DAY=3
RISK_MAX_POSITION_PCT=100
RISK_NO_ENTRIES_BEFORE=09:15
RISK_NO_ENTRIES_AFTER=15:00

# Universe / scan controls
# MAX_DEEP_SCAN caps how many liquid names get an intraday historical pull per run.
# The cheap bulk-quote layer still covers ALL liquid NSE EQ names for breadth and
# liquidity; only the deep (candle) scan is capped due to Kite historical rate limits.
MAX_DEEP_SCAN=150
HISTORICAL_SLEEP_SEC=0.35
RVOL_MIN_SESSIONS=10
STALE_CANDLE_MINUTES=20

# Transaction-cost model (percent of turnover unless noted). Defaults approximate a
# discount broker's intraday equity schedule; verify against your broker's contract note.
COST_BROKERAGE_PCT=0.03
COST_BROKERAGE_CAP_INR=20
COST_STT_PCT=0.025
COST_EXCHANGE_TXN_PCT=0.00297
COST_SEBI_PCT=0.0001
COST_STAMP_PCT=0.003
COST_GST_PCT=18
COST_SLIPPAGE_PCT=0.05

# Optional: if you have a permitted news feed, normalize headlines into news.csv.
NEWS_CSV=news.csv
