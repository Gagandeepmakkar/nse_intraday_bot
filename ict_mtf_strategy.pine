//@version=6
// ════════════════════════════════════════════════════════════════════════════════
//  ICT / SMC Multi-Timeframe Confirmation Strategy
//  Apply on the 5-MINUTE chart. Pulls 15M, 4H, Daily, Weekly via request.security.
//
//  Strict sequence (no signal until EVERY mandatory step is confirmed, in order):
//    1. Price reaches a Higher-TF Order Block (W / D / 4H) in the HTF bias direction
//    2. 4H CISD + 4H FVG aligned with bias
//    3. Two recent liquidity sweeps aligned with bias (2 swing-low / 2 swing-high)
//    4. Daily FVG aligned with bias
//    5. 15M CISD + 15M FVG aligned with bias
//    6. 5M  CISD + 5M  FVG aligned with bias
//    7. Price taps a 5M or 15M FVG  +  Risk:Reward >= 1:3  ->  BUY / SELL signal
//
//  Non-repainting: every higher-TF value is read from the CLOSED bar ([1]) with
//  lookahead_off. Chart-TF pivots are confirmed (lag = pivot length).
//
//  NOTE: ICT concepts are defined operationally below. Tune the definitions/inputs
//  to match your exact interpretation.
// ════════════════════════════════════════════════════════════════════════════════
indicator('ICT MTF Strategy', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ── Timeframes ──────────────────────────────────────────────────────────────────
TF_W  = 'W'
TF_D  = 'D'
TF_4H = '240'
TF_15 = '15'
// chart timeframe is expected to be 5M

// ── Inputs: display toggles ───────────────────────────────────────────────────────
grpD      = 'Display'
showOB    = input.bool(true,  'Show Order Blocks (W/D/4H)', group = grpD)
showFVGz  = input.bool(true,  'Show FVG zones (D/4H/5M)',   group = grpD)
showSweep = input.bool(true,  'Mark liquidity sweeps',      group = grpD)
showCISD  = input.bool(true,  'Mark 5M CISD',               group = grpD)
showDash  = input.bool(true,  'Show confirmation dashboard', group = grpD)
showSLTP  = input.bool(true,  'Show SL / TP lines',         group = grpD)

// ── Inputs: logic ─────────────────────────────────────────────────────────────────
grpL      = 'Logic'
swLen     = input.int(5,  'Swing pivot length (sweeps)', minval = 2, maxval = 50, group = grpL)
minRR     = input.float(3.0, 'Minimum Risk:Reward', minval = 1.0, step = 0.5, group = grpL)
slBufTk   = input.int(5,  'SL buffer (ticks)', minval = 0, group = grpL)
stageTO   = input.int(500, 'Setup timeout (5M bars)', minval = 50, group = grpL,
     tooltip = 'If the sequence does not complete within this many bars, it resets.')
obRight   = input.int(30, 'OB / FVG zone extend (bars)', minval = 5, group = grpL)

// ── Inputs: colors ────────────────────────────────────────────────────────────────
grpC      = 'Colors'
cBull     = input.color(color.new(#089981, 0),  'Bullish', group = grpC)
cBear     = input.color(color.new(#f23645, 0),  'Bearish', group = grpC)
cOBbull   = input.color(color.new(#089981, 80), 'Bull OB fill',  group = grpC)
cOBbear   = input.color(color.new(#f23645, 80), 'Bear OB fill',  group = grpC)
cFVGbull  = input.color(color.new(#2157f3, 82), 'Bull FVG fill', group = grpC)
cFVGbear  = input.color(color.new(#ff9800, 82), 'Bear FVG fill', group = grpC)

// ════════════════════════════════════════════════════════════════════════════════
//  REUSABLE DETECTION FUNCTIONS  (run in chart ctx AND inside request.security)
//  Every return value is indexed [1] => only CLOSED bars => non-repainting.
// ════════════════════════════════════════════════════════════════════════════════

// Fair Value Gap (3-candle imbalance). Bull: gap up. Bear: gap down.
f_fvg() =>
    bull = low > high[2]
    bear = high < low[2]
    // confirmed values from the previous closed bar
    [bull[1], bear[1], high[3], low[1], low[3], high[1]]
    // returns: bullFVG, bearFVG, bullTop(high[2]->[3]), bullBot(low[0]->[1]),
    //          bearTop(low[2]->[3]), bearBot(high[0]->[1])

// Change in State of Delivery: reclaiming the origin of the last opposite run.
f_cisd() =>
    var float bearOrigin = na   // open of first candle of latest bearish run
    var float bullOrigin = na   // open of first candle of latest bullish run
    var int   dir        = 0
    if close < open
        if dir != -1
            bearOrigin := open
            dir := -1
    else if close > open
        if dir != 1
            bullOrigin := open
            dir := 1
    bull = not na(bearOrigin) and close > bearOrigin
    bear = not na(bullOrigin) and close < bullOrigin
    [bull[1], bear[1]]

// Order Block: last opposite candle before a displacement that breaks its range.
f_ob() =>
    var float buTop = na, var float buBot = na
    var float beTop = na, var float beBot = na
    if close > high[1] and close[1] < open[1]      // up displacement after a down candle
        buTop := high[1]
        buBot := low[1]
    if close < low[1] and close[1] > open[1]       // down displacement after an up candle
        beTop := high[1]
        beBot := low[1]
    [buTop[1], buBot[1], beTop[1], beBot[1]]

// HTF directional bias from break of structure (pivot break).
f_bias() =>
    ph = ta.pivothigh(5, 5)
    pl = ta.pivotlow(5, 5)
    var float lastPH = na
    var float lastPL = na
    var int   b      = 0
    if not na(ph)
        lastPH := ph
    if not na(pl)
        lastPL := pl
    if not na(lastPH) and close > lastPH
        b := 1
    if not na(lastPL) and close < lastPL
        b := -1
    b[1]

// ════════════════════════════════════════════════════════════════════════════════
//  HIGHER-TIMEFRAME PULLS (non-repainting)
// ════════════════════════════════════════════════════════════════════════════════
[wBuTop, wBuBot, wBeTop, wBeBot] = request.security(syminfo.tickerid, TF_W,  f_ob(),  lookahead = barmerge.lookahead_off)
[dBuTop, dBuBot, dBeTop, dBeBot] = request.security(syminfo.tickerid, TF_D,  f_ob(),  lookahead = barmerge.lookahead_off)
[hBuTop, hBuBot, hBeTop, hBeBot] = request.security(syminfo.tickerid, TF_4H, f_ob(),  lookahead = barmerge.lookahead_off)

[h4_fBull, h4_fBear, h4_fbuT, h4_fbuB, h4_fbeT, h4_fbeB] = request.security(syminfo.tickerid, TF_4H, f_fvg(), lookahead = barmerge.lookahead_off)
[d_fBull,  d_fBear,  d_fbuT,  d_fbuB,  d_fbeT,  d_fbeB ] = request.security(syminfo.tickerid, TF_D,  f_fvg(), lookahead = barmerge.lookahead_off)
[m15_fBull, m15_fBear, m15_fbuT, m15_fbuB, m15_fbeT, m15_fbeB] = request.security(syminfo.tickerid, TF_15, f_fvg(), lookahead = barmerge.lookahead_off)

[h4_cBull, h4_cBear]   = request.security(syminfo.tickerid, TF_4H, f_cisd(), lookahead = barmerge.lookahead_off)
[m15_cBull, m15_cBear] = request.security(syminfo.tickerid, TF_15, f_cisd(), lookahead = barmerge.lookahead_off)

bias4H = request.security(syminfo.tickerid, TF_4H, f_bias(), lookahead = barmerge.lookahead_off)

// ── Chart-native (5M) detections ──────────────────────────────────────────────────
[m5_fBull, m5_fBear, m5_fbuT, m5_fbuB, m5_fbeT, m5_fbeB] = f_fvg()
[m5_cBull, m5_cBear] = f_cisd()

// ════════════════════════════════════════════════════════════════════════════════
//  LIQUIDITY SWEEPS (chart TF, confirmed pivots -> non-repainting)
// ════════════════════════════════════════════════════════════════════════════════
ph5 = ta.pivothigh(swLen, swLen)
pl5 = ta.pivotlow(swLen, swLen)

var array<float> swHighs = array.new<float>()
var array<float> swLows  = array.new<float>()

if not na(ph5)
    array.push(swHighs, ph5)
    if array.size(swHighs) > 30
        array.shift(swHighs)
if not na(pl5)
    array.push(swLows, pl5)
    if array.size(swLows) > 30
        array.shift(swLows)

var int sweepLowCount  = 0
var int sweepHighCount = 0

// bull setup wants swing-LOW sweeps; bear setup wants swing-HIGH sweeps
bool sweptLow  = false
bool sweptHigh = false
float lastSwLow  = array.size(swLows)  > 0 ? array.get(swLows,  array.size(swLows)  - 1) : na
float lastSwHigh = array.size(swHighs) > 0 ? array.get(swHighs, array.size(swHighs) - 1) : na

if not na(lastSwLow) and low < lastSwLow and close > lastSwLow
    sweptLow := true
    sweepLowCount += 1
    array.pop(swLows)            // consume this level so next sweep targets the prior one
if not na(lastSwHigh) and high > lastSwHigh and close < lastSwHigh
    sweptHigh := true
    sweepHighCount += 1
    array.pop(swHighs)

// ════════════════════════════════════════════════════════════════════════════════
//  BIAS + "PRICE REACHED AN ORDER BLOCK"
// ════════════════════════════════════════════════════════════════════════════════
bias = bias4H   // +1 bull, -1 bear, 0 none

inZone(float top, float bot) =>
    not na(top) and not na(bot) and low <= top and high >= bot

reachedBullOB = inZone(wBuTop, wBuBot) or inZone(dBuTop, dBuBot) or inZone(hBuTop, hBuBot)
reachedBearOB = inZone(wBeTop, wBeBot) or inZone(dBeTop, dBeBot) or inZone(hBeTop, hBeBot)

// ════════════════════════════════════════════════════════════════════════════════
//  PER-DIRECTION STEP CONDITIONS
// ════════════════════════════════════════════════════════════════════════════════
// Bull
b_c1 = bias == 1 and reachedBullOB
b_c2 = h4_cBull and h4_fBull
b_c3 = sweepLowCount >= 2
b_c4 = d_fBull
b_c5 = m15_cBull and m15_fBull
b_c6 = m5_cBull  and m5_fBull
b_tap = (m5_fBull  and low <= m5_fbuT  and high >= m5_fbuB) or (m15_fBull and low <= m15_fbuT and high >= m15_fbuB)
// Bear
s_c1 = bias == -1 and reachedBearOB
s_c2 = h4_cBear and h4_fBear
s_c3 = sweepHighCount >= 2
s_c4 = d_fBear
s_c5 = m15_cBear and m15_fBear
s_c6 = m5_cBear  and m5_fBear
s_tap = (m5_fBear  and high >= m5_fbeB  and low <= m5_fbeT) or (m15_fBear and high >= m15_fbeB and low <= m15_fbeT)

// ════════════════════════════════════════════════════════════════════════════════
//  STRICT SEQUENTIAL STATE MACHINE
// ════════════════════════════════════════════════════════════════════════════════
var int   stage      = 0    // 0..6; 7th condition fires the signal
var int   dirLock    = 0
var int   stageBars  = 0

// reset when bias flips / disappears
if bias != dirLock
    stage      := 0
    dirLock    := bias
    stageBars  := 0
    sweepLowCount  := 0
    sweepHighCount := 0

c1 = bias == 1 ? b_c1 : bias == -1 ? s_c1 : false
c2 = bias == 1 ? b_c2 : s_c2
c3 = bias == 1 ? b_c3 : s_c3
c4 = bias == 1 ? b_c4 : s_c4
c5 = bias == 1 ? b_c5 : s_c5
c6 = bias == 1 ? b_c6 : s_c6
cTap = bias == 1 ? b_tap : s_tap

bool fireLong  = false
bool fireShort = false

if bias != 0
    stageBars += 1
    if stage == 0 and c1
        stage := 1
        stageBars := 0
    else if stage == 1 and c2
        stage := 2
        stageBars := 0
    else if stage == 2 and c3
        stage := 3
        stageBars := 0
    else if stage == 3 and c4
        stage := 4
        stageBars := 0
    else if stage == 4 and c5
        stage := 5
        stageBars := 0
    else if stage == 5 and c6
        stage := 6
        stageBars := 0
    else if stage == 6 and cTap
        // final stage handled below (needs RR check before firing)
        stage := stage
    // timeout
    if stageBars > stageTO
        stage := 0
        stageBars := 0

// ════════════════════════════════════════════════════════════════════════════════
//  RISK : REWARD  &  SIGNAL EMISSION
// ════════════════════════════════════════════════════════════════════════════════
tickBuf = slBufTk * syminfo.mintick

var float sigEntry = na
var float sigSL    = na
var float sigTP    = na
var float sigRR    = na

calcRR_long() =>
    _entry = close
    _sl    = (na(lastSwLow) ? low : math.min(lastSwLow, low)) - tickBuf
    _tp    = na(lastSwHigh) ? na : lastSwHigh
    _risk  = _entry - _sl
    _rr    = (not na(_tp) and _risk > 0) ? (_tp - _entry) / _risk : na
    [_entry, _sl, _tp, _rr]

calcRR_short() =>
    _entry = close
    _sl    = (na(lastSwHigh) ? high : math.max(lastSwHigh, high)) + tickBuf
    _tp    = na(lastSwLow) ? na : lastSwLow
    _risk  = _sl - _entry
    _rr    = (not na(_tp) and _risk > 0) ? (_entry - _tp) / _risk : na
    [_entry, _sl, _tp, _rr]

if stage == 6 and bias == 1 and b_tap
    [e, sl, tp, rr] = calcRR_long()
    if not na(rr) and rr >= minRR
        fireLong  := true
        sigEntry  := e
        sigSL     := sl
        sigTP     := tp
        sigRR     := rr
        stage     := 0
        stageBars := 0

if stage == 6 and bias == -1 and s_tap
    [e, sl, tp, rr] = calcRR_short()
    if not na(rr) and rr >= minRR
        fireShort := true
        sigEntry  := e
        sigSL     := sl
        sigTP     := tp
        sigRR     := rr
        stage     := 0
        stageBars := 0

// ════════════════════════════════════════════════════════════════════════════════
//  DRAWINGS
// ════════════════════════════════════════════════════════════════════════════════
// --- Order-block zones (latest per TF/dir) ---
f_zone(box b, float top, float bot, color col, bool show) =>
    box _b = b
    if show and not na(top) and not na(bot)
        if na(_b)
            _b := box.new(bar_index, top, bar_index + obRight, bot, bgcolor = col, border_color = color.new(col, 40))
        else
            box.set_top(_b, top)
            box.set_bottom(_b, bot)
            box.set_right(_b, bar_index + obRight)
    _b

var box bxWbu = na, var box bxWbe = na
var box bxDbu = na, var box bxDbe = na
var box bxHbu = na, var box bxHbe = na
bxWbu := f_zone(bxWbu, wBuTop, wBuBot, cOBbull, showOB)
bxWbe := f_zone(bxWbe, wBeTop, wBeBot, cOBbear, showOB)
bxDbu := f_zone(bxDbu, dBuTop, dBuBot, cOBbull, showOB)
bxDbe := f_zone(bxDbe, dBeTop, dBeBot, cOBbear, showOB)
bxHbu := f_zone(bxHbu, hBuTop, hBuBot, cOBbull, showOB)
bxHbe := f_zone(bxHbe, hBeTop, hBeBot, cOBbear, showOB)

// --- Daily & 4H FVG zones (latest) ---
var box bxDfvgU = na, var box bxDfvgD = na
var box bxHfvgU = na, var box bxHfvgD = na
if showFVGz
    if d_fBull
        bxDfvgU := f_zone(bxDfvgU, d_fbuT, d_fbuB, cFVGbull, true)
    if d_fBear
        bxDfvgD := f_zone(bxDfvgD, d_fbeT, d_fbeB, cFVGbear, true)
    if h4_fBull
        bxHfvgU := f_zone(bxHfvgU, h4_fbuT, h4_fbuB, cFVGbull, true)
    if h4_fBear
        bxHfvgD := f_zone(bxHfvgD, h4_fbeT, h4_fbeB, cFVGbear, true)

// --- 5M FVG boxes (rolling history, capped) ---
var array<box> m5boxes = array.new<box>()
f_pushFVG(float top, float bot, color col) =>
    if showFVGz
        b = box.new(bar_index - 1, top, bar_index + obRight, bot, bgcolor = col, border_color = color.new(col, 30))
        array.push(m5boxes, b)
        if array.size(m5boxes) > 20
            box.delete(array.shift(m5boxes))
if m5_fBull
    f_pushFVG(m5_fbuT, m5_fbuB, cFVGbull)
if m5_fBear
    f_pushFVG(m5_fbeT, m5_fbeB, cFVGbear)

// --- Sweep markers ---
plotshape(showSweep and sweptLow,  title = 'Sweep Low',  style = shape.triangleup,   location = location.belowbar, color = cBull, size = size.tiny)
plotshape(showSweep and sweptHigh, title = 'Sweep High', style = shape.triangledown, location = location.abovebar, color = cBear, size = size.tiny)

// --- 5M CISD markers ---
plotshape(showCISD and m5_cBull, title = '5M CISD Bull', style = shape.diamond, location = location.belowbar, color = color.new(cBull, 30), size = size.tiny)
plotshape(showCISD and m5_cBear, title = '5M CISD Bear', style = shape.diamond, location = location.abovebar, color = color.new(cBear, 30), size = size.tiny)

// --- Entry signals ---
plotshape(fireLong,  title = 'BUY',  style = shape.labelup,   location = location.belowbar, color = cBull, textcolor = color.white, text = 'BUY',  size = size.normal)
plotshape(fireShort, title = 'SELL', style = shape.labeldown, location = location.abovebar, color = cBear, textcolor = color.white, text = 'SELL', size = size.normal)

// --- SL / TP lines + RR label ---
var line  lnSL = na, var line lnTP = na, var line lnEN = na
var label lbRR = na
if (fireLong or fireShort) and showSLTP
    if not na(lnSL)
        line.delete(lnSL)
    if not na(lnTP)
        line.delete(lnTP)
    if not na(lnEN)
        line.delete(lnEN)
    if not na(lbRR)
        label.delete(lbRR)
    col = fireLong ? cBull : cBear
    lnEN := line.new(bar_index, sigEntry, bar_index + obRight, sigEntry, color = color.gray,  width = 1, style = line.style_dashed)
    lnSL := line.new(bar_index, sigSL,    bar_index + obRight, sigSL,    color = cBear,        width = 1)
    lnTP := line.new(bar_index, sigTP,    bar_index + obRight, sigTP,    color = cBull,        width = 1)
    lbRR := label.new(bar_index + obRight, sigTP, 'RR ' + str.tostring(sigRR, '#.##') + '  TP ' + str.tostring(sigTP, format.mintick) + '\nSL ' + str.tostring(sigSL, format.mintick), style = label.style_label_left, color = color.new(col, 20), textcolor = color.white, size = size.small)

// ════════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ════════════════════════════════════════════════════════════════════════════════
alertcondition(fireLong,  'BUY signal',  'ICT MTF BUY: all confirmations met, RR >= target')
alertcondition(fireShort, 'SELL signal', 'ICT MTF SELL: all confirmations met, RR >= target')

// ════════════════════════════════════════════════════════════════════════════════
//  CONFIRMATION DASHBOARD
// ════════════════════════════════════════════════════════════════════════════════
f_yn(bool v) => v ? '✓' : '—'
f_col(bool v) => v ? cBull : color.gray

if showDash and barstate.islast
    var table t = table.new(position.top_right, 2, 11, bgcolor = color.new(chart.bg_color, 0), border_color = chart.fg_color, frame_color = chart.fg_color, frame_width = 1, border_width = 1)
    biasTxt = bias == 1 ? 'BULLISH' : bias == -1 ? 'BEARISH' : 'NONE'
    biasCol = bias == 1 ? cBull : bias == -1 ? cBear : color.gray

    table.cell(t, 0, 0, 'HTF Bias', text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, biasTxt,   text_color = biasCol,         text_size = size.small)

    table.cell(t, 0, 1, '1. Reached HTF OB',  text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 1, f_yn(stage >= 1),     text_color = f_col(stage >= 1), text_size = size.tiny)
    table.cell(t, 0, 2, '2. 4H CISD + FVG',   text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 2, f_yn(stage >= 2),     text_color = f_col(stage >= 2), text_size = size.tiny)
    table.cell(t, 0, 3, '3. 2x Liq Sweeps',   text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 3, f_yn(stage >= 3),     text_color = f_col(stage >= 3), text_size = size.tiny)
    table.cell(t, 0, 4, '4. Daily FVG',       text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 4, f_yn(stage >= 4),     text_color = f_col(stage >= 4), text_size = size.tiny)
    table.cell(t, 0, 5, '5. 15M CISD + FVG',  text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 5, f_yn(stage >= 5),     text_color = f_col(stage >= 5), text_size = size.tiny)
    table.cell(t, 0, 6, '6. 5M CISD + FVG',   text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 6, f_yn(stage >= 6),     text_color = f_col(stage >= 6), text_size = size.tiny)
    table.cell(t, 0, 7, '7. FVG tap + RR>=' + str.tostring(minRR, '#.#'), text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 7, f_yn(fireLong or fireShort), text_color = f_col(fireLong or fireShort), text_size = size.tiny)

    table.cell(t, 0, 8, 'Low sweeps',  text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 8, str.tostring(sweepLowCount),  text_color = chart.fg_color, text_size = size.tiny)
    table.cell(t, 0, 9, 'High sweeps', text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 9, str.tostring(sweepHighCount), text_color = chart.fg_color, text_size = size.tiny)
    table.cell(t, 0, 10, 'Stage', text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 10, str.tostring(stage) + '/6', text_color = chart.fg_color, text_size = size.tiny)

// ── Wrong-timeframe warning ───────────────────────────────────────────────────────
if barstate.islast and timeframe.in_seconds() != timeframe.in_seconds('5')
    label.new(bar_index, high, 'Apply this indicator on the 5-MINUTE chart', style = label.style_label_down, color = color.new(color.orange, 0), textcolor = color.black, size = size.normal)
