//@version=6
// BTC/ETH Donchian Trend + PLAN — the SAME strategy the BTC extension computes, drawn on
// the chart so TradingView and the panel agree. Long+short trend-following: enter on a
// 20-bar Donchian breakout (DAILY), ride it with a 3xATR Chandelier trailing stop, exit
// when the trail is hit. This is the ONE crypto approach that backtested POSITIVE over 8y.
//
// IMPORTANT: the whole strategy is computed on DAILY bars via request.security, so it works
// and stays FIXED on ANY chart timeframe — your entry/stop/target will NOT drift when you
// view a 1h/15m chart, and will not repaint intrabar. Entry commits on the confirmed daily
// close (that is how you trade it). Patient. Honour the stop. NOT financial advice.
indicator("BTC Donchian Trend + Plan (daily-locked)", overlay=true, max_labels_count=300, max_lines_count=500)

// ------------------------------------------------------------------ inputs
period     = input.int(20, "Donchian period", minval=5)
atrMult    = input.float(3.0, "ATR trailing-stop multiple", step=0.5)
atrLen     = input.int(14, "ATR length")
allowShort = input.bool(true, "Trade shorts too (profit in downtrends)")
tgtR       = input.float(2.0, "Reference target (R multiple)", step=0.5, tooltip="A visual target at N x the initial risk. The REAL exit is the trailing stop — the edge is letting winners run, so treat this as a partial-book reference, not a hard exit.")
showPlan   = input.bool(true, "Show the pending plan while flat")

// ------------------------------------------------------------------ the engine, on DAILY bars
// Runs the full state machine on the daily series. Gated on barstate.isconfirmed so the
// FORMING daily bar never repaints — entry/stop/target lock on the confirmed daily close.
calc() =>
    u   = ta.highest(high, period)[1]   // prior N-day high = long breakout level
    l   = ta.lowest(low, period)[1]     // prior N-day low  = short breakout level
    av  = ta.atr(atrLen)
    hhv = ta.highest(high, period)
    llv = ta.lowest(low, period)
    var int   p = 0
    var float e = na
    var float s = na
    var float r = na
    if barstate.isconfirmed
        if p == 0
            if close > u
                p := 1
                e := close
                s := hhv - atrMult * av
                r := math.max(math.abs(e - s), av)
            else if allowShort and close < l
                p := -1
                e := close
                s := llv + atrMult * av
                r := math.max(math.abs(e - s), av)
        else if p == 1
            s := math.max(s, hhv - atrMult * av)   // Chandelier trail ratchets up only
            if close < s
                p := 0
                e := na
                s := na
                r := na
        else
            s := math.min(s, llv + atrMult * av)   // ratchets down only
            if close > s
                p := 0
                e := na
                s := na
                r := na
    [p, e, s, r, u, l, hhv, llv, av]

[pos, entry, stop, risk0, upper, lower, hh, ll, a] = request.security(syminfo.tickerid, "1D", calc(), lookahead=barmerge.lookahead_off)

// ------------------------------------------------------------------ derived
target  = pos == 1 ? entry + tgtR * risk0 : pos == -1 ? entry - tgtR * risk0 : na
posPrev = nz(pos[1], 0)
enterLong  = pos == 1  and posPrev != 1
enterShort = pos == -1 and posPrev != -1
exitTrade  = pos == 0  and posPrev != 0

// profit-protection state: once the trail crosses past entry, the stop is locking gains,
// not sitting as a raw risk stop. (long: stop>entry · short: stop<entry)
locked  = (pos == 1 and stop > entry) or (pos == -1 and stop < entry)
lockAmt = locked ? math.abs(stop - entry) : na
lockR   = locked and not na(risk0) and risk0 != 0 ? math.abs(stop - entry) / risk0 : na
tgtHit  = (pos == 1 and close >= target) or (pos == -1 and close <= target)

// the PLAN while flat (leading): where the next trade triggers, with its stop and target
planOn  = showPlan and pos == 0
lStop   = hh - atrMult * a
lRisk   = math.max(upper - lStop, a)
lTarget = upper + tgtR * lRisk
sStop   = ll + atrMult * a
sRisk   = math.max(sStop - lower, a)
sTarget = lower - tgtR * sRisk

// ------------------------------------------------------------------ plots: levels you can SEE
plot(upper, "Donchian high", color.new(color.teal, 55), 1)
plot(lower, "Donchian low",  color.new(color.teal, 55), 1)
plot(pos != 0 ? entry  : na, "ENTRY",  color.new(color.blue, 0),  2, plot.style_linebr)
plot(pos != 0 ? stop   : na, "STOP / Trail", color = locked ? color.new(color.lime, 0) : color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
plot(pos != 0 ? target : na, "TARGET (ref)", color.new(color.green, 0), 2, plot.style_linebr)
plot(planOn ? upper   : na, "Long trigger",  color.new(color.green, 20), 2, plot.style_linebr)
plot(planOn ? lStop   : na, "Long stop",     color.new(color.red, 55),   1, plot.style_linebr)
plot(planOn ? lTarget : na, "Long target",   color.new(color.green, 55), 1, plot.style_linebr)
plot(planOn and allowShort ? lower   : na, "Short trigger", color.new(color.red, 20),  2, plot.style_linebr)
plot(planOn and allowShort ? sStop   : na, "Short stop",    color.new(color.red, 70),  1, plot.style_linebr)
plot(planOn and allowShort ? sTarget : na, "Short target",  color.new(color.green, 70),1, plot.style_linebr)

bgcolor(pos == 1 ? color.new(color.green, 92) : pos == -1 ? color.new(color.red, 92) : na, title="Position")

plotshape(enterLong,  "Enter long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), text="LONG",  size=size.small)
plotshape(enterShort, "Enter short", shape.triangledown, location.abovebar, color.new(color.red, 0),   text="SHORT", size=size.small)
plotshape(exitTrade,  "Exit",        shape.xcross,       location.abovebar, color.new(color.gray, 0),  text="EXIT",  size=size.tiny)

// ------------------------------------------------------------------ closed-trade record (persists)
var float lastEntry = na
var int   lastEntryBar = na
var int   lastDir = 0
var float lastRisk = na
if enterLong or enterShort
    lastEntry := entry
    lastEntryBar := bar_index
    lastDir := pos
    lastRisk := risk0
if exitTrade and not na(lastEntry)
    won  = lastDir * (close - lastEntry) > 0
    xcol = won ? color.new(color.lime, 0) : color.new(color.red, 0)
    line.new(lastEntryBar, lastEntry, bar_index, close, color=xcol, width=2, style=line.style_dashed)
    rr   = not na(lastRisk) and lastRisk != 0 ? lastDir * (close - lastEntry) / lastRisk : na
    pctC = lastDir * (close / lastEntry - 1) * 100
    label.new(bar_index, close, (lastDir == 1 ? "L" : "S") + " closed " + str.tostring(pctC, "#.0") + "% (" + str.tostring(rr, "#.0#") + "R) · trail hit", color=xcol, style=label.style_label_up, textcolor=color.white, size=size.tiny)

// ------------------------------------------------------------------ right-edge labels
var label lE = na
var label lS = na
var label lT = na
label.delete(lE)
label.delete(lS)
label.delete(lT)
if barstate.islast
    if pos != 0
        sTxt = locked ? "TRAIL · locks +" + str.tostring(lockAmt, format.mintick) + " (" + str.tostring(lockR, "#.0#") + "R)" : "STOP " + str.tostring(stop, format.mintick)
        tTxt = tgtHit ? "TARGET ✓ hit " + str.tostring(target, format.mintick) : "TARGET " + str.tostring(target, format.mintick)
        lE := label.new(bar_index, entry,  "ENTRY " + str.tostring(entry, format.mintick), color=color.new(color.blue, 20), style=label.style_label_left, textcolor=color.white, size=size.small)
        lS := label.new(bar_index, stop,   sTxt, color = locked ? color.new(color.green, 0) : color.new(color.red, 10), style=label.style_label_left, textcolor=color.white, size=size.small)
        lT := label.new(bar_index, target, tTxt, color = tgtHit ? color.new(color.green, 0) : color.new(color.green, 40), style=label.style_label_left, textcolor=color.white, size=size.small)
    else if planOn
        lE := label.new(bar_index, upper,   "LONG if daily close>" + str.tostring(upper, format.mintick), color=color.new(color.green, 20), style=label.style_label_left, textcolor=color.white, size=size.small)
        lT := label.new(bar_index, lTarget, "→ target " + str.tostring(lTarget, format.mintick) + " / stop " + str.tostring(lStop, format.mintick), color=color.new(color.gray, 30), style=label.style_label_left, textcolor=color.white, size=size.small)
        if allowShort
            lS := label.new(bar_index, lower, "SHORT if daily close<" + str.tostring(lower, format.mintick) + " → tgt " + str.tostring(sTarget, format.mintick) + " / stop " + str.tostring(sStop, format.mintick), color=color.new(color.red, 20), style=label.style_label_left, textcolor=color.white, size=size.small)

// ------------------------------------------------------------------ dashboard
var table tb = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    st   = pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT"
    scol = pos == 1 ? color.new(color.green, 0) : pos == -1 ? color.new(color.red, 0) : color.new(color.gray, 35)
    pnl  = pos != 0 and not na(entry) ? pos * (close / entry - 1) * 100 : na
    rNow = pos != 0 and not na(risk0) ? pos * (close - entry) / risk0 : na
    table.cell(tb, 0, 0, "Donchian Trend · DAILY", text_color=color.white, bgcolor=color.new(color.black, 10))
    table.cell(tb, 1, 0, st, text_color=color.white, bgcolor=scol)
    table.cell(tb, 0, 1, locked ? "Entry / Trail 🔒" : "Entry / Stop", text_color=color.white, bgcolor=color.new(color.gray, 55))
    stopCellTxt = pos == 0 ? "—" : str.tostring(entry, format.mintick) + " / " + str.tostring(stop, format.mintick) + (locked ? "  (locks +" + str.tostring(lockAmt, format.mintick) + ")" : "")
    table.cell(tb, 1, 1, stopCellTxt, text_color = locked ? color.lime : color.silver)
    table.cell(tb, 0, 2, "Target (ref)", text_color=color.white, bgcolor=color.new(color.gray, 55))
    table.cell(tb, 1, 2, pos == 0 ? "—" : (tgtHit ? "✓ hit " : "") + str.tostring(target, format.mintick), text_color = tgtHit ? color.lime : color.silver)
    table.cell(tb, 0, 3, "Open P&L / R", text_color=color.white, bgcolor=color.new(color.gray, 55))
    table.cell(tb, 1, 3, na(pnl) ? "—" : str.tostring(pnl, "#.0") + "% (" + str.tostring(rNow, "#.0#") + "R)", text_color = na(pnl) ? color.silver : pnl >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 4, "PLAN (if flat)", text_color=color.white, bgcolor=color.new(color.gray, 55))
    table.cell(tb, 1, 4, pos != 0 ? "in trade — trail " + str.tostring(stop, format.mintick) : ("long>" + str.tostring(upper, format.mintick) + (allowShort ? " / short<" + str.tostring(lower, format.mintick) : "")), text_color=color.silver)
    table.cell(tb, 0, 5, "Data", text_color=color.white, bgcolor=color.new(color.gray, 55))
    table.cell(tb, 1, 5, "Daily-locked ✓ (any chart TF)", text_color=color.lime)

// ------------------------------------------------------------------ alerts
if enterLong
    alert("Donchian LONG " + syminfo.ticker + " @" + str.tostring(close, format.mintick) + " · stop " + str.tostring(stop, format.mintick) + " · target " + str.tostring(target, format.mintick), alert.freq_once_per_bar_close)
if enterShort
    alert("Donchian SHORT " + syminfo.ticker + " @" + str.tostring(close, format.mintick) + " · stop " + str.tostring(stop, format.mintick) + " · target " + str.tostring(target, format.mintick), alert.freq_once_per_bar_close)
if exitTrade
    alert("Donchian EXIT " + syminfo.ticker + " — trailing stop hit", alert.freq_once_per_bar_close)
