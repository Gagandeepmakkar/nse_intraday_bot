//@version=6
// VIM STRATEGY (NSE) — the backtestable twin of vim_nse.pine. Same logic, but written as
// a strategy() so TradingView's Strategy Tester computes REAL historical stats: net profit,
// win rate, profit factor, max drawdown, avg win/loss, Sharpe. Costs are built in
// (commission + slippage) so the result is honest — unlike the academic papers, which
// charged no spread/slippage and looked far better than reality.
//
// HOW IT TRADES (identical to the indicator):
//   Direction : 20-min opening-range sign AND side of VWAP (momentum regime).
//   Timing    : enter on a pullback to EMA9 then resumption (reversal timing).
//   Risk      : fixed 1.2-ATR stop = 1R. Position vol-targeted (constant % risk).
//   Exit      : scale 1/3 at +1R, then Chandelier-trail (HH - 3*ATR) the rest; EOD square-off.
//
// READ THE BACKTEST HONESTLY: one symbol's result is not proof. Run it across 10-20 NSE
// names and multiple years. Look at PROFIT FACTOR (>1.3 = promising, ~1.0 = no edge) and
// MAX DRAWDOWN (can you stomach it?). If most symbols show profit factor ~1.0 after costs,
// that is the real finding — the edge isn't there, and no tweak will conjure it.
strategy("VIM Strategy (NSE)", overlay=true, max_labels_count=200, initial_capital=100000, default_qty_type=strategy.fixed, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, calc_on_every_tick=false)

// ===== Inputs =====
orMinutes = input.int(20, "Opening range (minutes)", options=[15, 20, 30], group="Signal")
atrLen    = input.int(14, "ATR length", group="Signal")
emaLen    = input.int(9,  "Pullback EMA", group="Signal")
maxTrades = input.int(2,  "Max trades per day", minval=1, group="Signal")
stopATR   = input.float(1.2, "Stop distance (ATR) = 1R", step=0.1, minval=0.3, group="Risk")
scaleR    = input.float(1.0, "Scale out 1/3 at (R)", step=0.5, minval=0.5, group="Risk")
trailATR  = input.float(3.0, "Chandelier trail (ATR)", step=0.5, minval=1, group="Risk")
riskPct   = input.float(0.5, "Risk % of equity per trade", step=0.1, group="Risk")
sqHour    = input.int(15, "Square-off hour (IST)", group="Session")
sqMin     = input.int(15, "Square-off minute (IST)", group="Session")

// ===== Indicators / anchors =====
atr  = ta.atr(atrLen)
ema  = ta.ema(close, emaLen)
vwap = ta.vwap(hlc3)
plot(vwap, "VWAP", color.new(color.blue, 0), 1)
plot(ema,  "EMA",  color.new(color.orange, 40), 1)

// ===== Session clock (IST) =====
tz = "Asia/Kolkata"
th = hour(time, tz)
tm = minute(time, tz)
minsSinceOpen = (th - 9) * 60 + (tm - 15)
inOR    = minsSinceOpen >= 0 and minsSinceOpen < orMinutes
afterOR = minsSinceOpen >= orMinutes
sqOff   = (th > sqHour) or (th == sqHour and tm >= sqMin)
newDay  = ta.change(time("D")) != 0

// ===== Opening range =====
var float orHigh = na
var float orLow  = na
var float orOpen = na
var float orClose= na
var int   tradesToday = 0
if newDay
    orHigh := na
    orLow := na
    orOpen := na
    orClose := na
    tradesToday := 0
if inOR
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)
    orOpen := na(orOpen) ? open : orOpen
    orClose := close

orBull = not na(orClose) and not na(orOpen) and orClose > orOpen
orBear = not na(orClose) and not na(orOpen) and orClose < orOpen
momUp  = afterOR and orBull and close > vwap and not na(orHigh) and (orHigh - orLow) > 0
momDn  = afterOR and orBear and close < vwap and not na(orLow)  and (orHigh - orLow) > 0

// ===== Reversal-timed entry arming =====
var bool armedLong  = false
var bool armedShort = false
if newDay
    armedLong := false
    armedShort := false
if strategy.position_size == 0 and momUp and close < ema
    armedLong := true
if strategy.position_size == 0 and momDn and close > ema
    armedShort := true
if not momUp
    armedLong := false
if not momDn
    armedShort := false

canTrade = afterOR and not sqOff and tradesToday < maxTrades
longEntry  = canTrade and strategy.position_size == 0 and momUp and armedLong  and ta.crossover(close, ema)
shortEntry = canTrade and strategy.position_size == 0 and momDn and armedShort and ta.crossunder(close, ema)

// ===== Vol-targeted sizing =====
stopDist = stopATR * atr
qtyShares = stopDist > 0 ? math.floor((riskPct / 100.0 * strategy.equity) / stopDist) : 0

// ===== State for exit management =====
var float entry    = na
var float origStop = na
var float riskPts  = na
var float hh       = na
var float ll       = na
var bool  scaledOut= false

if longEntry and qtyShares > 0
    strategy.entry("L", strategy.long, qty=qtyShares)
    entry := close
    riskPts := stopDist
    origStop := close - stopDist
    hh := high
    scaledOut := false
    tradesToday := tradesToday + 1
    armedLong := false
if shortEntry and qtyShares > 0
    strategy.entry("S", strategy.short, qty=qtyShares)
    entry := close
    riskPts := stopDist
    origStop := close + stopDist
    ll := low
    scaledOut := false
    tradesToday := tradesToday + 1
    armedShort := false

// ===== Convex exits via the strategy engine =====
if strategy.position_size > 0
    hh := math.max(hh, high)
    if not scaledOut and high >= entry + scaleR * riskPts
        strategy.close("L", qty_percent=33.334, comment="+1R scale")
        scaledOut := true
    curStop = scaledOut ? math.max(entry, hh - trailATR * atr) : origStop
    strategy.exit("L-exit", from_entry="L", stop=curStop)
    if sqOff
        strategy.close("L", comment="EOD")
if strategy.position_size < 0
    ll := math.min(ll, low)
    if not scaledOut and low <= entry - scaleR * riskPts
        strategy.close("S", qty_percent=33.334, comment="+1R scale")
        scaledOut := true
    curStopS = scaledOut ? math.min(entry, ll + trailATR * atr) : origStop
    strategy.exit("S-exit", from_entry="S", stop=curStopS)
    if sqOff
        strategy.close("S", comment="EOD")

// ===== Visuals =====
curStopPlot = strategy.position_size > 0 ? (scaledOut ? math.max(entry, hh - trailATR * atr) : origStop) : strategy.position_size < 0 ? (scaledOut ? math.min(entry, ll + trailATR * atr) : origStop) : na
plot(strategy.position_size != 0 ? entry : na, "Entry", color.new(color.blue, 0), 2, plot.style_linebr)
plot(curStopPlot, "Stop/Trail", color.new(color.red, 0), 2, plot.style_linebr)
bgcolor(inOR ? color.new(color.gray, 85) : na, title="Opening range")
plotshape(longEntry,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), text="BUY",  size=size.small)
plotshape(shortEntry, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   text="SELL", size=size.small)
