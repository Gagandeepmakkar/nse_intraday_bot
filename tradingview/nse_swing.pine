//@version=6
// NSE Swing — SELECTIVE. A clean chart with only the best few trades. It signals
// BUY only on a pullback inside a STRONG trend (EMAs stacked, higher timeframe
// agrees, price dipped to the EMA20 with RSI pulling back, then reclaims) — and a
// cooldown prevents clustered signals. On a daily chart expect a handful of signals
// over months, not every candle. Confirmation only; paper-trade first.
indicator("NSE Swing (selective)", overlay=true, max_lines_count=60, max_labels_count=60)

// ===== Inputs =====
rsiDip    = input.float(48, "Pullback depth — RSI must dip below", group="Selectivity")
cooldown  = input.int(10, "Min bars between signals", minval=1, group="Selectivity")
pbZone    = input.float(0.6, "Pullback zone (% around EMA20)", step=0.1, group="Selectivity")
r1        = input.float(2.0, "Target 1 = risk ×", step=0.5, group="Risk")
r2        = input.float(3.0, "Target 2 = risk ×", step=0.5, group="Risk")
showTable = input.bool(true, "Status table", group="Display")

// ===== Indicators (clean: 3 EMAs only) =====
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi = ta.rsi(close, 14)
atr = ta.atr(14)

plot(ema20,  "EMA20",  color.new(color.green, 0), 1)
plot(ema50,  "EMA50",  color.new(color.orange, 0), 1)
plot(ema200, "EMA200", color.new(color.gray, 20), 2)

// ===== Higher-timeframe trend filter (auto step up) =====
autoHtf = timeframe.isintraday ? "D" : timeframe.period == "D" ? "W" : "M"
htfE20 = request.security(syminfo.tickerid, autoHtf, ta.ema(close, 20), lookahead=barmerge.lookahead_off)
htfE50 = request.security(syminfo.tickerid, autoHtf, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
htfUp   = htfE20 > htfE50
htfDown = htfE20 < htfE50

// ===== Strong trend (EMAs stacked) =====
upTrend   = ema20 > ema50 and ema50 > ema200 and close > ema20
downTrend = ema20 < ema50 and ema50 < ema200 and close < ema20

// ===== Pullback + reclaim (buy the dip, not the top) =====
zone = ema20 * pbZone / 100
dippedUp   = ta.lowest(low, 6)  <= ema20 + zone         // price dipped to EMA20
rsiDipUp   = ta.lowest(rsi, 6)  <  rsiDip               // momentum pulled back
reclaimUp  = close > open and close > ema20 and rsi > rsi[1]   // bouncing now

dippedDn   = ta.highest(high, 6) >= ema20 - zone
rsiDipDn   = ta.highest(rsi, 6)  >  (100 - rsiDip)
reclaimDn  = close < open and close < ema20 and rsi < rsi[1]

// ===== Cooldown so signals don't cluster =====
var int lastSig = na
canFire = na(lastSig) or (bar_index - lastSig) > cooldown

buy  = upTrend   and htfUp   and dippedUp and rsiDipUp and reclaimUp and canFire
sell = downTrend and htfDown and dippedDn and rsiDipDn and reclaimDn and canFire
if buy or sell
    lastSig := bar_index

// ===== Draw entry / stop / targets =====
drawTrade(_e, _sl, _t1, _t2, _long) =>
    xr = bar_index + 20
    line.new(bar_index, _e,  xr, _e,  color=color.new(color.aqua, 0), width=2)
    line.new(bar_index, _sl, xr, _sl, color=color.new(color.red, 0), width=1, style=line.style_dashed)
    line.new(bar_index, _t1, xr, _t1, color=color.new(color.yellow, 0), width=1, style=line.style_dashed)
    line.new(bar_index, _t2, xr, _t2, color=color.new(color.green, 0), width=1, style=line.style_dashed)
    rr = math.round(math.abs(_t1 - _e) / math.abs(_e - _sl), 2)
    label.new(bar_index, _e, (_long ? "BUY " : "SELL ") + str.tostring(_e, format.mintick) + "   R:R " + str.tostring(rr),
              style=_long ? label.style_label_up : label.style_label_down,
              color=_long ? color.green : color.red, textcolor=color.white, size=size.normal)

if buy
    sl = math.min(ta.lowest(low, 6), close - atr)
    risk = close - sl
    drawTrade(close, sl, close + r1 * risk, close + r2 * risk, true)
if sell
    sl = math.max(ta.highest(high, 6), close + atr)
    risk = sl - close
    drawTrade(close, sl, close - r1 * risk, close - r2 * risk, false)

plotshape(buy,  "BUY",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.normal, text="BUY")
plotshape(sell, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.normal, text="SELL")

// ===== Small status table =====
col(c) => c ? color.lime : color.red
var table tb = table.new(position.top_right, 2, 4, border_width=1)
if showTable and barstate.islast
    tr = upTrend ? "UPTREND" : downTrend ? "DOWNTREND" : "no clean trend"
    table.cell(tb, 0, 0, "Trend ("+timeframe.period+")", text_color=color.white, bgcolor=color.new(color.gray, 55))
    table.cell(tb, 1, 0, tr, text_color = upTrend ? color.lime : downTrend ? color.red : color.silver)
    table.cell(tb, 0, 1, "Higher TF ("+autoHtf+")", text_color=color.white, bgcolor=color.new(color.gray, 55))
    table.cell(tb, 1, 1, htfUp ? "UP" : htfDown ? "DOWN" : "FLAT", text_color = col(htfUp))
    table.cell(tb, 0, 2, "RSI(14)", text_color=color.white, bgcolor=color.new(color.gray, 55))
    table.cell(tb, 1, 2, str.tostring(rsi, "#.0"), text_color = rsi > 60 ? color.lime : rsi < 40 ? color.red : color.silver)
    table.cell(tb, 0, 3, "Setup", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(tb, 1, 3, buy ? "BUY now" : sell ? "SELL now" : upTrend ? "wait for dip" : "stand aside", text_color = buy ? color.lime : sell ? color.red : color.silver)

// ===== Alerts =====
alertcondition(buy,  "Swing BUY",  'BUY {{ticker}} {{interval}} at {{close}}')
alertcondition(sell, "Swing SELL", 'SELL {{ticker}} {{interval}} at {{close}}')
